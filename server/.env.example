# Copy this file to .env and fill in your own values. Never commit .env.

PORT=8787

# Which provider the server should call: "openai" or "anthropic"
CHAT_PROVIDER=openai

# OpenAI (used when CHAT_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (used when CHAT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Comma-separated list of origins allowed to call this API, or "*" for any origin.
# For local testing with index.html opened via a static file server, "*" is fine.
# For a real deployment, set this to your site's actual origin, e.g.:
# ALLOWED_ORIGIN=https://your-site.example.com
ALLOWED_ORIGIN=*
